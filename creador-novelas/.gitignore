# entorno
.venv/
__pycache__/
*.pyc
.pytest_cache/

# cursor transitorio de tanda y estado de hooks (spec técnica §5)
.tanda/

# artefactos de trabajo del loop (spec técnica §8.2): no son estado
04_estado/prompts/
04_estado/deltas/

# ejemplos de referencia del subgénero (RF-00.2): fuera de git, se conserva la carpeta
00_referencias/*
!00_referencias/.gitkeep

# Salida derivada de `ensamblar`: se regenera desde 05_manuscrito/ (spec tecnica 8.2)
08_entrega/

# novelas archivadas: el harness las produce, no son código. Lo que se guarda de ellas es la fila de
# medidas en corridas.csv, que es la evidencia de HALLAZGOS.md. Las 29 novelas del loop de velocidad
# (manuscritos, reportes de QA y registros) viven en la rama specs/velocidad si hacen falta.
09_archivo/*
!09_archivo/corridas.csv
!09_archivo/corridas.jsonl
