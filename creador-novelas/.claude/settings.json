{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m app:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python.exe \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session_start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Agent|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python.exe \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python.exe \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post_tool_use.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "escritor|extractor|qa",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python.exe \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/subagent_stop.py"
          }
        ]
      }
    ]
  }
}
