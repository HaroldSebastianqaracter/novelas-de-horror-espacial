# Configuracion de storyMaker: las variables de entorno que lee src/backend/config.py, el
# unico sitio donde se lee el entorno.
#
# config.py lee el entorno del proceso y NO carga ningun fichero .env por su cuenta. Hay que
# fijarlas en la consola antes de lanzar worker, API o demo (en cmd, `set NOVELAS_PUERTO=falso`;
# ver src/backend/README.md) o hacer que tu IDE cargue una copia de este fichero llamada .env,
# que no se commitea.
#
# Ninguna variable lleva claves: Claude Code usa su propia sesion iniciada y el backend no
# gestiona ni pasa credenciales al subproceso.

# Fichero SQLite de la story bible. Obligatoria.
NOVELAS_DB_PATH=novela.db

# 'falso' corre el pipeline entero con agentes de demostracion, sin gastar nada.
# 'terminal' invoca a Claude Code de verdad: cuesta dinero.
NOVELAS_PUERTO=falso

# Ejecutable de Claude Code, si no esta en el PATH como 'claude'.
NOVELAS_CLAUDE_BIN=claude

# Cada cuantos segundos el worker mira la cola de intenciones.
NOVELAS_POLL_SEGUNDOS=2

# Tiempo maximo de una llamada de agente, en segundos.
NOVELAS_TIMEOUT_AGENTE_SEGUNDOS=1800

# Techo de tokens por llamada al modelo. El paquete de contexto usa este techo menos una
# reserva fija para la salida del agente.
NOVELAS_PRESUPUESTO_TOKENS=100000

# Indice vectorial de recuperacion: 1 activo, 0 desactivado. Es derivado; sin el, el
# pipeline corre igual.
NOVELAS_VECTORES=1

# Modelo de embeddings local y multilingue. Si no carga, el indice queda desactivado.
NOVELAS_EMBEDDING_MODELO=intfloat/multilingual-e5-small

# Directorio de respuestas grabadas para el puerto falso. Vacio = agentes de demostracion.
NOVELAS_PUERTO_FALSO_DIR=
